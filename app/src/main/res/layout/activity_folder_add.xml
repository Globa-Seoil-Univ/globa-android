<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.folder.add.FolderAddActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_folder_add_header"
        android:layout_width="match_parent"
        android:layout_height="71dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/button_folder_add_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/header_back"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textview_folder_add_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:fontFamily="@font/notosans_regular"
            android:text="@string/add"
            android:textColor="@color/primary"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/textview_folder_add_announce"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/notosans_bold"
        android:text="@string/folder_add_title"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_folder_add_header" />

    <EditText
        android:id="@+id/edittext_folder_add_input_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:autofillHints="name"
        android:fontFamily="@font/notosans_regular"
        android:hint="@string/activity_folder_add_input_name"
        android:inputType="text"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:textSize="@dimen/normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textview_folder_add_announce" />

    <Button
        android:id="@+id/button_folder_add_cancel"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/cancel"
        android:backgroundTint="@color/gray"
        app:layout_constraintBottom_toBottomOf="@id/edittext_folder_add_input_name"
        app:layout_constraintEnd_toEndOf="@id/edittext_folder_add_input_name"
        app:layout_constraintTop_toTopOf="@id/edittext_folder_add_input_name" />

    <TextView
        android:id="@+id/textview_folder_add_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/notosans_regular"
        android:text="0/32"
        android:textColor="@color/gray"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/button_folder_add_cancel"
        app:layout_constraintStart_toStartOf="@id/button_folder_add_cancel"
        app:layout_constraintTop_toBottomOf="@+id/edittext_folder_add_input_name"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/textview_folder_add_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/notosans_regular"
        android:textColor="@color/red"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/edittext_folder_add_input_name"
        app:layout_constraintTop_toBottomOf="@id/textview_folder_add_count" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textview_folder_add_share_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/notosans_bold"
        android:text="@string/activity_folder_share_title"
        android:textColor="@color/black"
        android:textSize="@dimen/big"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edittext_folder_add_input_name" />

    <EditText
        android:id="@+id/edittext_folder_add_share_input_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/notosans_regular"
        android:hint="@string/activity_fonder_add_input_share"
        android:importantForAutofill="no"
        android:inputType="text"
        android:textColor="@color/black"
        android:textColorHint="@color/lightGray"
        android:textSize="@dimen/normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textview_folder_add_share_title" />

    <Button
        android:id="@+id/button_folder_share_share_cancel"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/cancel"
        android:backgroundTint="@color/gray"
        app:layout_constraintBottom_toBottomOf="@+id/edittext_folder_add_share_input_name"
        app:layout_constraintEnd_toEndOf="@+id/edittext_folder_add_share_input_name"
        app:layout_constraintTop_toTopOf="@+id/edittext_folder_add_share_input_name" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintlayout_folder_add_share_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/folder_share_item"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edittext_folder_add_share_input_name">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imageview_folder_add_share_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/profile_user"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textview_folder_add_share_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/notosans_regular"
            android:textColor="@color/black"
            android:textSize="@dimen/large"
            app:layout_constraintBottom_toBottomOf="@+id/imageview_folder_add_share_search"
            app:layout_constraintStart_toEndOf="@+id/imageview_folder_add_share_search"
            app:layout_constraintTop_toTopOf="@+id/imageview_folder_add_share_search" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_folder_add_share_selected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintlayout_folder_add_share_search" />

</androidx.constraintlayout.widget.ConstraintLayout>