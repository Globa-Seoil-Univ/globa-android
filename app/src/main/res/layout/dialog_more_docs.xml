<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/modal_background">

    <RelativeLayout
        android:id="@+id/relativelayout_more_docs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linearlayout_more_docs_tab"
            android:layout_width="44dp"
            android:layout_height="8dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/alert_tab"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/textview_more_docs_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/docs_more_title"
            android:textColor="@color/black"
            android:textSize="@dimen/normal"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textview_more_docs_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textview_more_docs_title"
            android:layout_marginTop="5dp"
            android:text="@string/docs_more_datetime"
            android:textColor="@color/darkGray"
            android:textSize="@dimen/small" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/relative_layout_more_docs_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:gravity="center"
        android:orientation="vertical"
        android:rowCount="1"
        app:layout_constraintTop_toBottomOf="@+id/relativelayout_more_docs">


        <RelativeLayout
            android:id="@+id/relativelayout_more_rename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp">

            <ImageButton
                android:id="@+id/image_button_more_rename"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:importantForAccessibility="no"
                android:src="@drawable/rename" />

            <TextView
                android:id="@+id/textview_more_rename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@+id/image_button_more_rename"
                android:text="@string/rename"
                android:textColor="@color/black" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relativelayout_more_move"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="20dp">

            <ImageButton
                android:id="@+id/image_button_more_move"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:importantForAccessibility="no"
                android:src="@drawable/move_docs" />

            <TextView
                android:id="@+id/textview_more_move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@+id/image_button_more_move"
                android:text="@string/docs_more_move_docs"
                android:textColor="@color/black" />
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/relativelayout_more_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="30dp">

            <ImageButton
                android:id="@+id/image_button_more_delete"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:importantForAccessibility="no"
                android:src="@drawable/delete_docs" />

            <TextView
                android:id="@+id/textview_more_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@+id/image_button_more_delete"
                android:text="@string/docs_more_delete_docs"
                android:textColor="@color/red" />
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>