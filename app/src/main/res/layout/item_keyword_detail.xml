<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">

    <TextView
        android:id="@+id/textview_keyword_detail_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="@dimen/normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1." />

    <TextView
        android:id="@+id/textview_keyword_detail_item_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/black"
        android:textSize="@dimen/normal"
        app:layout_constraintBottom_toBottomOf="@+id/textview_keyword_detail_number"
        app:layout_constraintStart_toEndOf="@+id/textview_keyword_detail_number"
        app:layout_constraintTop_toTopOf="@+id/textview_keyword_detail_number"
        tools:text="단어" />

    <TextView
        android:id="@+id/textview_keyword_detail_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/item_label_keyword"
        android:textColor="@color/white"
        android:textSize="@dimen/small"
        app:layout_constraintStart_toEndOf="@+id/textview_keyword_detail_item_word"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="명사" />

    <TextView
        android:id="@+id/textview_keyword_detail_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="11dp"
        android:textColor="@color/black"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_keyword_detail_number"
        tools:text="선을 봄." />

</androidx.constraintlayout.widget.ConstraintLayout>