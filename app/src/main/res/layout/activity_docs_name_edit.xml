<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="team.y2k2.globa.docs.edit.DocsNameEditViewModel" /> <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".docs.edit.DocsNameEditActivity"> <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_docs_name_header"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/button_docs_name_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:background="@drawable/header_back" android:onClick="@{() -> viewModel.onBackClicked()}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textview_docs_name_change_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/notosans_regular"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/change" android:onClick="@{() -> viewModel.onConfirmClicked()}"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:textColor="@color/primary" />


        <TextView
            android:id="@+id/textview_docs_name_edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/notosans_regular"
            android:text="@string/rename"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="@dimen/large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/textview_docs_name_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp" android:fontFamily="@font/notosans_bold"
            android:text="@string/activity_docs_name_edit_title" android:textColor="@color/black"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_docs_name_header" />

        <EditText
            android:id="@+id/edittext_docs_name_input_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:autofillHints="name"
            android:fontFamily="@font/notosans_regular"
            android:inputType="text"
            android:maxLength="32"
            android:text="@={viewModel.currentTitle}" android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textview_docs_name_title"
            tools:ignore="LabelFor" />

        <Button
            android:id="@+id/button_docs_name_cancel"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/cancel" android:backgroundTint="@color/gray"
            android:onClick="@{() -> viewModel.onCancelClicked()}"
            app:layout_constraintBottom_toBottomOf="@+id/edittext_docs_name_input_name"
            app:layout_constraintEnd_toEndOf="@id/edittext_docs_name_input_name"
            app:layout_constraintTop_toTopOf="@+id/edittext_docs_name_input_name"
            tools:visibility="visible" />
        <TextView
            android:id="@+id/textview_docs_name_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginEnd="10dp"
            android:fontFamily="@font/notosans_regular"
            android:text="@{viewModel.charCountText}" android:textColor="@color/gray"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/edittext_docs_name_input_name"
            app:layout_constraintTop_toBottomOf="@+id/edittext_docs_name_input_name"
            tools:text="3/32" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>